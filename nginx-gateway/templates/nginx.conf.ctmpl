events {}

http {
    upstream nodos_pool {
        {{range service "nodos"}}
        server {{.Address}}:{{.Port}};
        {{else}}
        server 127.0.0.1:65535;
        {{end}}
    }

    upstream enlaces_pool {
        {{range service "enlaces"}}
        server {{.Address}}:{{.Port}};
        {{else}}
        server 127.0.0.1:65535;
        {{end}}
    }

    upstream envios_pool {
        {{range service "envios"}}
        server {{.Address}}:{{.Port}};
        {{else}}
        server 127.0.0.1:65535;
        {{end}}
    }

    server {
        listen 80;

        location /nodos {
            proxy_pass http://nodos_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /enlaces {
            proxy_pass http://enlaces_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /envios {
            proxy_pass http://envios_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}
